# Secrets and site settings for tools/expiry-check.py. Copy to
# /etc/inventree-pantry/expiry-check.env and `chmod 600` it — it holds a password.

# Where InvenTree answers. The machine running the check must be able to reach it; a LAN IP
# is fine and often more robust than a name behind a reverse proxy.
INVENTREE_URL=http://192.168.1.20:8080

# EITHER a user + password (recommended for an unattended job: tokens expire after a year) …
INVENTREE_USER=admin
INVENTREE_PASSWORD=change-me
# … OR an API token:
# INVENTREE_TOKEN=inv-…

# The link in the message, as the PHONE reaches it.
PANTRY_CLICK_URL=https://inventree.example.org/vorrat/

# ntfy (optional)
NTFY_URL=http://192.168.1.21:2586
NTFY_TOPIC=pantry

# Matrix (optional): a bot account's access token and a room it has joined.
# MATRIX_HOMESERVER=https://matrix.example.org
# MATRIX_ROOM=!abcdefg:example.org
# MATRIX_TOKEN=syt_…

# PANTRY_LANGUAGE=en        # overrides `language` from pantry.json
